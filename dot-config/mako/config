# GLOBAL
max-history=10
sort=-time

# BINDING OPTIONS
on-button-left=dismiss
on-button-middle=none
on-button-right=dismiss-all
on-touch=dismiss
on-notify=exec mpv /usr/share/sounds/freedesktop/stereo/message.oga --volume=30

# STYLE OPTIONS
font="Mononoki Nerd Font", 8
width=200
height=80
margin=3
padding=10
border-size=1
border-radius=12
icons=1
max-icon-size=48
icon-location=left
markup=1
actions=1
history=1
text-alignment=center
default-timeout=5000
ignore-timeout=0
max-visible=5
layer=overlay
anchor=top-right

background-color=#B37A89
text-color=#CC7787

[urgency=low]
border-color=#CC7787
background-color=#AE898D
text-color=#E6BFBF

[urgency=normal]
border-color=#B37A89
background-color=#9D8F99
text-color=#DDA5AA
default-timeout=10000
ignore-timeout=1

[urgency=high]
font="Mononoki Nerd Font", 14
border-color=#B37A89
background-color=#CC7787
text-color=#E6BFBF
default-timeout=0
ignore-timeout=1
